library(data.table)
library(dplyr)
derivation_pre <- fread("derivation_pre_logistic.csv")
replication_pre <- fread("replication_pre_logistic.csv")
derivation_pre <- derivation_pre %>%
  select(
    Exposure,
    Outcome,
    derivation_beta = beta,
    derivation_SE = SE,
    derivation_OR = OR,
    derivation_OR_lower = OR_95CI_lower,
    derivation_OR_upper = OR_95CI_upper,
    derivation_p = p.value.raw,
    derivation_N = N)
replication_pre <- replication_pre %>%
  select(
    Exposure,
    Outcome,
    replication_beta = beta,
    replication_SE = SE,
    replication_OR = OR,
    replication_OR_lower = OR_95CI_lower,
    replication_OR_upper = OR_95CI_upper,
    replication_p = p.value.raw,
    replication_N = N)
meta_pre <- inner_join(derivation_pre, replication_pre, by = c("Exposure", "Outcome"))
meta_pre <- meta_pre %>%
  mutate(
    derivation_beta = as.numeric(derivation_beta),
    derivation_SE = as.numeric(derivation_SE),
    replication_beta = as.numeric(replication_beta),
    replication_SE = as.numeric(replication_SE))
meta_pre <- meta_pre %>%
  mutate(
    weight_derivation = 1 / derivation_SE^2,
    weight_replication = 1 / replication_SE^2,
    pooled_beta = (weight_derivation * derivation_beta + weight_replication * replication_beta) / (weight_derivation + weight_replication),
    pooled_SE = sqrt(1 / (weight_derivation + weight_replication)),
    z_meta = pooled_beta / pooled_SE,
    p_meta = 2 * pnorm(
      abs(z_meta),
      lower.tail = FALSE),
    pooled_OR = exp(pooled_beta),
    pooled_OR_lower = exp(pooled_beta - 1.96 * pooled_SE),
    pooled_OR_upper = exp(pooled_beta + 1.96 * pooled_SE),
    Q = weight_derivation * (derivation_beta - pooled_beta)^2 + weight_replication * (replication_beta - pooled_beta)^2,
    Q_df = 1,
    Q_p = pchisq(Q, df = Q_df, lower.tail = FALSE),
    I2 = ifelse(Q > 0, pmax(0, (Q - Q_df) / Q) * 100, 0),
    derivation_weight_pct = weight_derivation / (weight_derivation + weight_replication) * 100,
    replication_weight_pct = weight_replication / (weight_derivation + weight_replication) * 100)
meta_pre <- meta_pre %>%
  mutate(
    FDR_Q_meta = p.adjust(p_meta,method = "fdr"),
    Bonferroni_meta = p.adjust(p_meta,method = "bonferroni"),
    Direction = case_when(
      pooled_OR > 1 ~ "Higher risk",
      pooled_OR < 1 ~ "Lower risk",
      TRUE ~ "No association"),
    Heterogeneity = case_when(
      I2 < 25 ~ "Low",
      I2 < 50 ~ "Moderate",
      I2 < 75 ~ "Substantial",
      TRUE ~ "Considerable"))
meta_pre_results <- meta_pre %>%
  select(
    Exposure,
    Outcome,
    derivation_beta,
    derivation_SE,
    derivation_OR,
    derivation_OR_lower,
    derivation_OR_upper,
    derivation_p,
    derivation_N,
    replication_beta,
    replication_SE,
    replication_OR,
    replication_OR_lower,
    replication_OR_upper,
    replication_p,
    replication_N,
    pooled_beta,
    pooled_SE,
    pooled_OR,
    pooled_OR_lower,
    pooled_OR_upper,
    z_meta,
    p_meta,
    FDR_Q_meta,
    Bonferroni_meta,
    Q,
    Q_df,
    Q_p,
    I2,
    derivation_weight_pct,
    replication_weight_pct,
    Direction,
    Heterogeneity
  ) %>%
  arrange(p_meta)
head(meta_pre_results, 20)
meta_pre_bon <- meta_pre_results %>% filter(Bonferroni_meta < 0.05)
fwrite(meta_pre_results,"meta_pre_logistic_all_results.csv")

