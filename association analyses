  mutate(
    weight_derivation = 1 / SE_derivation^2,
    weight_replication = 1 / SE_replication^2,
    total_weight = weight_derivation + weight_replication,
    pooled_beta = (weight_derivation * beta_derivation + weight_replication * beta_replication) / total_weight,
    pooled_SE = sqrt(1 / total_weight),
    pooled_HR = exp(pooled_beta),
    pooled_lower = exp(pooled_beta - qnorm(0.975) * pooled_SE),
    pooled_upper = exp(pooled_beta + qnorm(0.975) * pooled_SE),
    z_meta = pooled_beta / pooled_SE,
    p_meta = 2 * pnorm(-abs(z_meta)),
    Q = weight_derivation * (beta_derivation - pooled_beta)^2 + weight_replication * (beta_replication - pooled_beta)^2,
    Q_df = 1,
    Q_p = pchisq(Q, df = Q_df, lower.tail = FALSE),
    I2 = case_when(Q <= Q_df ~ 0, TRUE ~ 100 * (Q - Q_df) / Q),
    weight_derivation_pct = 100 * weight_derivation / total_weight,
    weight_replication_pct = 100 * weight_replication / total_weight,
