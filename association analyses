vars_used <- c("Age","Sex","Ethnicity","Qualifications","TDI","BMI","Smoking_status","Drinking_status","diet_score","Fasting_time","DM","hypertension","eGFR_stage")
derivation_epi_prevalent <- derivation_epi_prevalent[complete.cases(derivation_epi_prevalent[, ..vars_used]),]
cat("Final N used in all models:", nrow(derivation_epi_prevalent), "\n") #model2=186212
mydata1 <- derivation_epi_prevalent
var1 <- colnames(mydata1)[25:337] 
var2 <- "epi_status" 
covars <- c("Age","Sex","Ethnicity","Qualifications","TDI","BMI","Smoking_status","Drinking_status","diet_score","Fasting_time","DM","hypertension","eGFR_stage")
Result <- data.frame()
for (j in seq_along(var1)) {
  exposure <- var1[j]  
  glm_formula <- paste0(
    var2, " ~ ", exposure, " + ", paste(covars, collapse = "+"))  
  glm_model <- glm(as.formula(glm_formula), data = mydata1, family = binomial(link = "logit"))  
  x <- summary(glm_model)  
  beta <- x$coefficients[2, "Estimate"]
  se   <- x$coefficients[2, "Std. Error"]
  pval <- x$coefficients[2, "Pr(>|z|)"] 
  n    <- nobs(glm_model)  
  or <- exp(beta)
  or_lower <- exp(beta - 1.96 * se)
  or_upper <- exp(beta + 1.96 * se)  
  res <- data.frame(
    Exposure = exposure,     
    Outcome = var2,          
    beta = sprintf("%.3f", beta),      
    SE = sprintf("%.3f", se),        
    OR = sprintf("%.3f", or),         
    OR_95CI_lower = sprintf("%.3f", or_lower),  
    OR_95CI_upper = sprintf("%.3f", or_upper), 
    p.value = ifelse(pval < 0.001, "<0.001", sprintf("%.3f", pval)),
    p.value.raw = pval,
    N = n,
    stringsAsFactors = FALSE)  
  Result <- rbind(Result, res)  
  if (j %% 10 == 0) cat("Finished:", j, "\n")
}
Result$p.value.raw <- as.numeric(Result$p.value.raw)
Result$FDR_Q <- p.adjust(Result$p.value.raw, "fdr")
Result$Bon <- p.adjust(Result$p.value.raw, "bonferroni")
write.csv(Result, "derivation_pre_logistic.csv", row.names = FALSE)

