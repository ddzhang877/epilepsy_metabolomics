for chrom in {1..22}
do
~/software/plink2 \
--bfile ~/PRS/Data/UKB_target_array_QC/UKB_gene_v3_imp_qc_chr${chrom} \
--score ~/PRS/PRScs/prscs_beta_out/chr${chrom}_pst_eff_a1_b0.5_phiauto_chr${chrom}.txt 2 4 6 list-variants cols=+scoresums \
--chr ${chrom} \
--out epi.chr${chrom}
done

library(data.table) 
prs_list <- list()
for (chr in 1:22) {
  file_name <- sprintf("epi.chr%d.sscore", chr)
  if (file.exists(file_name)) {
    dt <- fread(file_name, select = c(2, 6), skip = 1, col.names = c("IID", paste0("chr", chr)))
    if (length(prs_list) == 0) {
      prs_list[[1]] <- dt
    } else {
      prs_list[[1]] <- merge(prs_list[[1]], dt, by = "IID", all = TRUE)
    }
  } else {
    message(sprintf("Warning: File %s not found", file_name))
  }
}
prs_table <- prs_list[[1]]
chr_cols <- grep("^chr", names(prs_table), value = TRUE)
prs_table$PRScs <- rowSums(prs_table[, ..chr_cols], na.rm = TRUE)
prs_table<-prs_table[,c(1,24)]
fwrite(prs_table, file = "~/PRS/PRScs/PRScs.txt", sep = "\t")








