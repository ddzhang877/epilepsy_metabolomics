#=========================================Base data=========================================
gwas_file <- "~/ILAE3_Caucasian_all_epilepsy_final.tbl"
data <- read.table(gwas_file,
                          header = TRUE,
                          sep = "",
                          stringsAsFactors = FALSE,
                          strip.white = TRUE)
setDT(data)
qc_gwas_for_prs <- function(data) { 
  data <- data[!is.na(data$Beta) & !is.na(data$SE) & !is.na(data$P.value) & !is.na(MarkerName)]  
  data[, OR := exp(Beta)]  
  data <- data[
    P.value > 0 & P.value <= 1 &
    SE > 0 &
    abs(Beta) < 5 &      
    OR < 10 & OR > 0.1    
  ]  
  return(data)
}

data_qc <- qc_gwas_for_prs(data)
data_qc<-subset(data_qc,data_qc$Freq1>0.01 & data_qc$Freq1<0.99) 
data_qc<-data_qc[,-c(8,11)]
data_qc<-subset(data_qc,!is.na(data_qc$CHR))
data_qc <- data_qc[!duplicated(MarkerName) & MarkerName != ".", ]
data_qc[, Allele1 := toupper(Allele1)]
data_qc[, Allele2 := toupper(Allele2)]
ambiguous <- (data_qc$Allele1 == "A" & data_qc$Allele2 == "T") |
  (data_qc$Allele1 == "T" & data_qc$Allele2 == "A") |
  (data_qc$Allele1 == "G" & data_qc$Allele2 == "C") |
  (data_qc$Allele1 == "C" & data_qc$Allele2 == "G")
data_qc <- data_qc[!ambiguous, ] 
fwrite(data_qc, "~/PRS/Data/Base_after_QC.txt", sep = "\t", quote = FALSE)
data_qc<-data_qc[,c("MarkerName","Allele1","Allele2","Beta","P.value")]
colnames(data_qc)<-c("SNP","A1","A2","BETA","P")
fwrite(data_qc, "~/PRS/Data/Base_after_QC_PRSCSinput_beta.txt", sep = "\t", quote = FALSE)

