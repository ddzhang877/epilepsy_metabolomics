`%||%` <- function(x, y) if (is.null(x)) y else x
bt <- function(x) paste0("`", gsub("`", "", x), "`")
safe01 <- function(x) {
  x_chr <- as.character(x)
  dplyr::case_when(
    x_chr %in% c("1", "case", "Case", "TRUE", "T", "yes", "Yes", "Y") ~ 1L,
    x_chr %in% c("0", "control", "Control", "FALSE", "F", "no", "No", "N") ~ 0L,
    TRUE ~ suppressWarnings(as.integer(x_chr))
  )
}

is_definite_zero <- function(x) {
  x_chr <- as.character(x)
  !is.na(x_chr) & x_chr %in% c("0", "FALSE", "F", "no", "No", "N")
}

sanitize_tag <- function(x) {
  x <- gsub("[^A-Za-z0-9_]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^_|_$", "", x)
  x
}

