  epi_status=factor(epi_status),Sex=factor(Sex),Ethnicity=factor(Ethnicity),Qualifications=factor(Qualifications),
  Qualifications=factor(Qualifications),Smoking_status=factor(Smoking_status),Drinking_status=factor(Drinking_status),DM=factor(DM),
  hypertension=factor(hypertension),eGFR_stage=factor(eGFR_stage),Imagingsite=factor(Imagingsite))
exposure_names <- unique(final_data$Field_ID)
all_columns <- names(scaled_DTI)
columns_image <- all_columns[67:120]
matched_columns <- columns_image[columns_image %in% exposure_names]
