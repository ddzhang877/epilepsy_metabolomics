import glob
import re
import os
import numpy as np
import pandas as pd
from tqdm import tqdm
import warnings
import random
from sklearn.metrics import roc_auc_score, confusion_matrix
from sklearn.metrics import roc_curve
from joblib import Parallel, delayed
warnings.filterwarnings('error')
def threshold(array, cutoff):
    array1 = array.copy()
    array1[array1 < cutoff] = 0
    array1[array1 >= cutoff] = 1
    return array1
def Find_Optimal_Cutoff(target, predicted):
    fpr, tpr, threshold = roc_curve(target, predicted)
    i = np.arange(len(tpr))
    roc = pd.DataFrame({'tf': pd.Series(tpr - (1 - fpr), index=i), 'threshold': pd.Series(threshold, index=i)})
    roc_t = roc.iloc[(roc.tf - 0).abs().argsort()[:1]]
    return list(roc_t['threshold'])
def get_eval(y_test, pred_prob, cutoff):
    pred_binary = threshold(pred_prob, cutoff)
    tn, fp, fn, tp = confusion_matrix(y_test, pred_binary).ravel()
    acc = (tp + tn) / (tp + tn + fp + fn)
    sens = tp / (tp + fn)
    spec = tn / (tn + fp)
    prec = tp / (tp + fp)
    Youden = sens + spec - 1
    f1 = 2 * prec * sens / (prec + sens)
    auc = roc_auc_score(y_test, pred_prob)
    evaluations = np.round((auc, acc, sens, spec, prec, Youden, f1), 5)
    evaluations = pd.DataFrame(evaluations).T
    evaluations.columns = ['AUC', 'Accuracy', 'Sensitivity', 'Specificity', 'Precision', 'Youden-index', 'F1-score']
    return evaluations
def convert_output(result_df):
    result_df = result_df.T
    result_df['Median'] = result_df.median(axis=1)
    result_df['LBD'] = result_df.quantile(0.025, axis=1)
    result_df['UBD'] = result_df.quantile(0.975, axis=1)
    output_lst = []
    for i in range(7):
        output_lst.append('{:.3f}'.format(result_df['Median'][i]) + ' [' +
                          '{:.3f}'.format(result_df['LBD'][i]) + ' - ' +
                          '{:.3f}'.format(result_df['UBD'][i]) + ']')
    result_df['output'] = output_lst
    myout = result_df.T
    return myout.iloc[-1, :]
def get_iter_output(mydf, gt_col, pred_lst, ct_lst, my_iter):
    tmp_random = np.random.RandomState(my_iter)
    bt_idx = tmp_random.choice(range(len(mydf)), size=len(mydf), replace=True)
    mydf_bt = mydf.copy()
    mydf_bt = mydf_bt.iloc[bt_idx, :]
    mydf_bt.reset_index(inplace=True, drop=True)
    y_test_bt = mydf_bt[gt_col]
    nmr_iter = get_eval(y_test_bt, mydf_bt[pred_lst[0]], ct_lst[0])
    top_nmr_iter = get_eval(y_test_bt, mydf_bt[pred_lst[1]], ct_lst[1])
    panel2_iter = get_eval(y_test_bt, mydf_bt[pred_lst[2]], ct_lst[2])
    panel3_iter = get_eval(y_test_bt, mydf_bt[pred_lst[3]], ct_lst[3])
    panel4_iter = get_eval(y_test_bt, mydf_bt[pred_lst[4]], ct_lst[4])
    panel23_iter = get_eval(y_test_bt, mydf_bt[pred_lst[5]], ct_lst[5])
    panel34_iter = get_eval(y_test_bt, mydf_bt[pred_lst[6]], ct_lst[6])
    panel234_iter = get_eval(y_test_bt, mydf_bt[pred_lst[7]], ct_lst[7])
    return (nmr_iter, top_nmr_iter, panel2_iter, panel3_iter, panel4_iter, panel23_iter, panel34_iter, panel234_iter)
nb_cpus = 40
tgt_pred_df = pd.read_csv('/.../NMR_Predictions.csv')
ct_nmr = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_nmr)[0]
ct_top_nmr = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_top_nmr)[0]
ct_panel2 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel2)[0]
ct_panel3 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel3)[0]
ct_panel4 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel4)[0]
ct_panel23 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel23)[0]
ct_panel34 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel34)[0]
ct_panel234 = Find_Optimal_Cutoff(tgt_pred_df.target_y, tgt_pred_df.y_pred_panel234)[0]
ct_lst = [ct_nmr, ct_top_nmr, ct_panel2, ct_panel3,ct_panel4, ct_panel23, ct_panel34,ct_panel234]
pred_lst = ['y_pred_nmr', 'y_pred_top_nmr', 'y_pred_panel2','y_pred_panel3','y_pred_panel4','y_pred_panel23','y_pred_panel34','y_pred_panel234']
iter_eval_lst = Parallel(n_jobs=nb_cpus)(delayed(get_iter_output)(tgt_pred_df, 'target_y', pred_lst, ct_lst, my_iter) for my_iter in range(500))
nmr_df, top_nmr_df, panel2_df, panel3_df, panel4_df = pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
panel23_df, panel34_df, panel234_df = pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
for iter_eval in iter_eval_lst:
    nmr_df = pd.concat([nmr_df, iter_eval[0]], axis=0)
    top_nmr_df = pd.concat([top_nmr_df, iter_eval[1]], axis=0)
    panel2_df = pd.concat([panel2_df, iter_eval[2]], axis=0)
    panel3_df = pd.concat([panel3_df, iter_eval[3]], axis=0)
    panel4_df = pd.concat([panel4_df, iter_eval[4]], axis=0)
    panel23_df = pd.concat([panel23_df, iter_eval[5]], axis=0)
    panel34_df = pd.concat([panel34_df, iter_eval[6]], axis=0)
    panel234_df = pd.concat([panel234_df, iter_eval[7]], axis=0)
res_nmr, res_top_nmr = convert_output(nmr_df), convert_output(top_nmr_df)
res_panel2, res_panel3, res_panel4 = convert_output(panel2_df), convert_output(panel3_df), convert_output(panel4_df)
res_panel23, res_panel34, res_panel234 = convert_output(panel23_df), convert_output(panel34_df), convert_output(panel234_df)
res_df = pd.concat([res_nmr, res_top_nmr, res_panel2, res_panel3, res_panel4, res_panel23, res_panel34, res_panel234], axis=1)
res_df = res_df.T
res_df.index = ['NMR', 'TopNMR', 'panel2', 'panel3','panel4','panel23','panel34','panel234']
res_df.to_csv('/.../result_s1.csv', index=True)
print("Finish!")


