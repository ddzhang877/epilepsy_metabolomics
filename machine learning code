                        'y_pred_panel23': y_panel23_lst, 'y_pred_panel34': y_panel34_lst, 'y_pred_panel234': y_panel234_lst,})
imp_df.to_csv('/.../NMR_Importance.csv', index=False)
pred_df.to_csv('/.../NMR_Predictions.csv', index=False)
print("Finish!")


