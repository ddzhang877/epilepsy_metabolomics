region_df = pd.read_csv("/.../physicaldata_all.csv",usecols=['eid','Region_code'])
nmr_cov_df = pd.merge(nmr_df, region_df, how = 'inner', on = ['eid'])
nmr_cov_df.rename(columns={'epi_status': 'target_y'}, inplace=True)
# incident
nmr_cov_df = nmr_cov_df[(nmr_cov_df['target_y'] == 0) | (nmr_cov_df['epi_years'] > 10)] # after 10 years
nmr_cov_df.loc[nmr_cov_df['epi_years'] > 10, 'target_y'] = 0 # before 10 years
# prevalent
nmr_cov_df.loc[nmr_cov_df['epi_years'] > -10, 'target_y'] = 0 # after 10 years
nmr_cov_df = nmr_cov_df[nmr_cov_df['epi_years'] >= -10] # before 10 years
fold_id_lst = [i for i in range(10)]
cov_f_lst2 = ["PRSCS","PC1","PC2","PC3","PC4","PC5","PC6","PC7","PC8","PC9","PC10"]
cov_f_lst3 = ["Age","Sex","TDI","Ethnicity","Qualifications"]
cov_f_lst4 = ["bl_injury","bl_infection","bl_stroke"]
tmp_df = nmr_cov_df
eid_lst, y_test_lst = [], []
tg_imp_cv, tc_imp_cv = Counter(), Counter()
y_pred_nmr_lst, y_pred_top_nmr_lst = [], []
y_panel2_lst, y_panel3_lst, y_panel4_lst = [], [], []
y_panel23_lst, y_panel34_lst, y_panel234_lst = [], [], []
fold_results_lst = Parallel(n_jobs=nb_cpus)(delayed(get_iter_predictions)(tmp_df, nmr_f_lst, cov_f_lst2, cov_f_lst3, cov_f_lst4, fold_id, my_params0, my_params) for fold_id in fold_id_lst)
for fold_results in fold_results_lst:
    tg_imp_cv += fold_results[0]
    tc_imp_cv += fold_results[1]
    eid_lst += fold_results[2]
    y_test_lst += fold_results[3]
    y_pred_nmr_lst += fold_results[4]
    y_pred_top_nmr_lst += fold_results[5]
    y_panel2_lst += fold_results[6]
    y_panel3_lst += fold_results[7]
    y_panel4_lst += fold_results[8]
    y_panel23_lst += fold_results[9]
    y_panel34_lst += fold_results[10]
    y_panel234_lst += fold_results[11]
tg_imp_cv = normal_imp(tg_imp_cv)
tg_imp_df = pd.DataFrame({'NMR_code': list(tg_imp_cv.keys()), 'TotalGain_cv': list(tg_imp_cv.values())})
tc_imp_cv = normal_imp(tc_imp_cv)
tc_imp_df = pd.DataFrame({'NMR_code': list(tc_imp_cv.keys()), 'TotalCover_cv': list(tc_imp_cv.values())})
imp_df = pd.merge(left=tc_imp_df, right=tg_imp_df, how='left', on=['NMR_code'])
