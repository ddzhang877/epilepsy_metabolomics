gwas_file <- "~/ILAE3_Caucasian_all_epilepsy_final.tbl"
outcome_raw <- read.table(gwas_file,
                          header = TRUE,
                          sep = "",
                          stringsAsFactors = FALSE,
                          strip.white = TRUE)
